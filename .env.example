# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=sb_secret_your_key
# Optional: inline JWKS. When omitted, Muna fetches and caches the project JWKS.
# SUPABASE_JWKS={"keys":[]}

# Server-only OpenAI configuration for Muna's text and tool-using agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Marin is Muna's warm feminine Realtime voice profile.
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Required for encrypted per-company email-provider credentials.
# Generate 32 random bytes and encode them as base64url. Never rotate this key
# without first reconnecting or re-encrypting every saved mailbox.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=

# Server-only, provider-neutral SMTP delivery.
# Optional deployment-wide fallback. Per-company settings take priority.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Muna Office <office@example.com>"
SMTP_REPLY_TO=

# Local prototype mode. Never enable for a production deployment.
NEXT_PUBLIC_DEMO_MODE=true
